<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>AutoRokScheduler</RootNamespace>
    <AssemblyName>AutoRokScheduler</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Auto-RoK Scheduler</Product>
  </PropertyGroup>

  <!-- App icon is optional: only wired in if Assets\app.ico actually exists,
       so a missing icon never breaks the build. -->
  <PropertyGroup Condition="Exists('Assets\app.ico')">
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Selenium 4.6+ bundles Selenium Manager, which auto-downloads the matching
         Edge/Chrome driver at runtime. No chromedriver/msedgedriver package needed. -->
    <PackageReference Include="Selenium.WebDriver" Version="4.47.0" />
    <PackageReference Include="Selenium.Support" Version="4.47.0" />
    <!-- Windows DPAPI (System.Security.Cryptography.ProtectedData) ships with the
         net10.0-windows desktop framework, so no explicit package reference is needed. -->
  </ItemGroup>

  <!-- The app icon is optional. If you don't have one yet, delete the
       <ApplicationIcon> line above and this ItemGroup to build without it. -->
  <ItemGroup>
    <None Update="Assets\app.ico" Condition="Exists('Assets\app.ico')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
