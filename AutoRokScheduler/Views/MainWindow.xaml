<Window x:Class="AutoRokScheduler.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Auto-RoK Scheduler" Height="700" Width="1060"
        MinHeight="560" MinWidth="880"
        WindowStyle="None" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        TextElement.Foreground="{StaticResource TextBrush}"
        TextElement.FontFamily="Segoe UI" TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== TITLE BAR ===================== -->
        <Grid Grid.Row="0" Background="{StaticResource SidebarBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Auto-RoK Scheduler" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="BtnMin" Style="{StaticResource TitleBarButton}" Click="Minimize_Click" Content="&#x2013;"/>
                <Button x:Name="BtnMax" Style="{StaticResource TitleBarButton}" Click="Maximize_Click" Content="&#x25A1;"/>
                <Button x:Name="BtnClose" Style="{StaticResource CloseButton}" Click="Close_Click" Content="&#x2715;"/>
            </StackPanel>
        </Grid>

        <!-- ===================== BODY ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== SIDEBAR ===== -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="ACCOUNTS" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" FontWeight="Bold" Margin="6,4,0,8"/>

                    <ListBox Grid.Row="1" x:Name="ProfileList"
                             ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource SidebarItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                             Margin="0,0,10,0" Fill="{Binding State, Converter={StaticResource StateBrush}}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2" Content="+  Add account" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="AddProfile_Click"/>

                    <Button Grid.Row="3" Content="⚙  Settings" Style="{StaticResource IconButton}"
                            HorizontalAlignment="Left" Margin="2,10,0,0" Click="Settings_Click"/>
                </Grid>
            </Border>

            <!-- ===== MAIN ===== -->
            <Grid Grid.Column="1" Margin="24">

                <!-- Placeholder when nothing is selected -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding Selected, Converter={StaticResource NullVis}}">
                    <TextBlock Text="No account selected" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Add an account on the left to get started." Foreground="{StaticResource MutedBrush}"
                               Margin="0,6,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Detail -->
                <Grid Visibility="{Binding Selected, Converter={StaticResource NotNullVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding Selected.Name}" FontSize="22" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding Selected.Login}" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="  ·  " Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding Selected.DeviceName}" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="  ·  " Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding Selected.BrowserText}" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Content="Edit" Style="{StaticResource GhostButton}" Click="EditProfile_Click" Margin="0,0,8,0"/>
                            <Button Content="Delete" Style="{StaticResource GhostButton}" Click="DeleteProfile_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Status card -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="16" Height="16" VerticalAlignment="Center"
                                         Fill="{Binding Selected.State, Converter={StaticResource StateBrush}}"/>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Selected.StatusText}" FontSize="20" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Selected.SinceText}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Cancel" Style="{StaticResource GhostButton}" Click="Cancel_Click"
                                        Margin="0,0,10,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
                                <Button x:Name="BtnStart" Content="▶  START" Style="{StaticResource StartButton}"
                                        Click="Start_Click" IsEnabled="{Binding NotBusy}" Margin="0,0,10,0"/>
                                <Button x:Name="BtnStop" Content="■  STOP" Style="{StaticResource StopButton}"
                                        Click="Stop_Click" IsEnabled="{Binding NotBusy}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Schedule card -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="SCHEDULE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                <Button Content="+  Add schedule" Style="{StaticResource GhostButton}"
                                        HorizontalAlignment="Right" Padding="10,6" Click="AddSchedule_Click"/>
                            </Grid>
                            <TextBlock Text="No schedule entries yet." Foreground="{StaticResource MutedBrush}"
                                       Margin="2,4" Visibility="{Binding Selected.Schedules.Count, Converter={StaticResource CountVis}, ConverterParameter=zero}"/>
                            <ItemsControl ItemsSource="{Binding Selected.Schedules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Card2Brush}" CornerRadius="8" Padding="12,10" Margin="0,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ActionText}" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="2" Text="{Binding DaysText}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                                <ToggleButton Grid.Column="3" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                                              IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="0,0,10,0"/>
                                                <Button Grid.Column="4" Content="Edit" Style="{StaticResource IconButton}" Click="EditSchedule_Click"/>
                                                <Button Grid.Column="5" Content="✕" Style="{StaticResource IconButton}" Click="DeleteSchedule_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Log card -->
                    <Border Grid.Row="3" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="LOG" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                <Button Content="Clear" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="ClearLog_Click"/>
                            </Grid>
                            <ScrollViewer Grid.Row="1" x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Log}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="66"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding TimeText}" Foreground="{StaticResource IdleBrush}"
                                                           FontFamily="Consolas" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap"
                                                           FontFamily="Consolas" FontSize="12"
                                                           Foreground="{Binding Level, Converter={StaticResource LogBrush}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
