<Window x:Class="AutoRokScheduler.Views.ScheduleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schedule" Width="440" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        TextElement.Foreground="{StaticResource TextBrush}"
        TextElement.FontFamily="Segoe UI" TextElement.FontSize="13">
    <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- title bar -->
            <Grid Grid.Row="0" Background="{StaticResource SidebarBrush}" Height="40" MouseLeftButtonDown="TitleBar_MouseDown">
                <TextBlock x:Name="TitleText" Text="Add schedule" Margin="14,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <Button Content="&#x2715;" Style="{StaticResource CloseButton}" HorizontalAlignment="Right" Click="Cancel_Click"/>
            </Grid>

            <!-- form -->
            <StackPanel Grid.Row="1" Margin="20,18,20,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TIME" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="HourCombo" Width="76"/>
                            <TextBlock Text=":" VerticalAlignment="Center" Margin="8,0" FontSize="16" FontWeight="Bold"/>
                            <ComboBox x:Name="MinuteCombo" Width="76"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ACTION" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ActionCombo">
                            <ComboBoxItem Content="Start"/>
                            <ComboBoxItem Content="Stop"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <TextBlock Text="DAYS" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                <ToggleButton x:Name="ChipDaily" Style="{StaticResource DayChip}" Content="Daily"
                              Width="72" HorizontalAlignment="Left" Margin="0,0,0,8" Click="Daily_Click"/>
                <WrapPanel>
                    <ToggleButton x:Name="ChipMon" Style="{StaticResource DayChip}" Content="Mon" Click="Day_Click"/>
                    <ToggleButton x:Name="ChipTue" Style="{StaticResource DayChip}" Content="Tue" Click="Day_Click"/>
                    <ToggleButton x:Name="ChipWed" Style="{StaticResource DayChip}" Content="Wed" Click="Day_Click"/>
                    <ToggleButton x:Name="ChipThu" Style="{StaticResource DayChip}" Content="Thu" Click="Day_Click"/>
                    <ToggleButton x:Name="ChipFri" Style="{StaticResource DayChip}" Content="Fri" Click="Day_Click"/>
                    <ToggleButton x:Name="ChipSat" Style="{StaticResource DayChip}" Content="Sat" Click="Day_Click"/>
                    <ToggleButton x:Name="ChipSun" Style="{StaticResource DayChip}" Content="Sun" Click="Day_Click"/>
                </WrapPanel>
                <TextBlock Text="Pick Daily for every day, or choose specific days." Foreground="{StaticResource IdleBrush}" FontSize="11" Margin="2,0,0,0"/>
            </StackPanel>

            <!-- footer -->
            <Grid Grid.Row="2" Margin="20,12,20,18">
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource StoppedBrush}" FontSize="12"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource GhostButton}" Click="Cancel_Click" Margin="0,0,10,0"/>
                    <Button Content="Save" Style="{StaticResource AccentButton}" Click="Save_Click" MinWidth="90"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
