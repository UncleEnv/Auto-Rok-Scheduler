<Window x:Class="AutoRokScheduler.Views.ProfileEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account" Width="460" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        TextElement.Foreground="{StaticResource TextBrush}"
        TextElement.FontFamily="Segoe UI" TextElement.FontSize="13">
    <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- title bar -->
            <Grid Grid.Row="0" Background="{StaticResource SidebarBrush}" Height="40" MouseLeftButtonDown="TitleBar_MouseDown">
                <TextBlock x:Name="TitleText" Text="Add account" Margin="14,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <Button Content="&#x2715;" Style="{StaticResource CloseButton}" HorizontalAlignment="Right" Click="Cancel_Click"/>
            </Grid>

            <!-- form -->
            <StackPanel Grid.Row="1" Margin="20,18,20,4">
                <TextBlock Text="ACCOUNT NAME" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NameBox"/>

                <TextBlock Text="LOGIN (EMAIL)" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                <TextBox x:Name="LoginBox"/>

                <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                <PasswordBox x:Name="PassBox"/>
                <TextBlock x:Name="PassHint" Text="Leave blank to keep the current password." Foreground="{StaticResource IdleBrush}"
                           FontSize="11" Margin="2,4,0,0" Visibility="Collapsed"/>

                <TextBlock Text="DEVICE NAME" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                <TextBox x:Name="DeviceBox"/>
                <TextBlock Text="The name the site asks for on first sign-in (e.g. Uncle)." Foreground="{StaticResource IdleBrush}"
                           FontSize="11" Margin="2,4,0,0"/>

                <TextBlock Text="BROWSER" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                <ComboBox x:Name="BrowserCombo">
                    <ComboBoxItem Content="Edge"/>
                    <ComboBoxItem Content="Chrome"/>
                </ComboBox>

                <TextBlock Text="BROWSER PROFILE FOLDER" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                <TextBox x:Name="ProfileKeyBox"/>
                <TextBlock x:Name="KeyHint" TextWrapping="Wrap" Foreground="{StaticResource IdleBrush}"
                           FontSize="11" Margin="2,4,0,0"
                           Text="Leave blank for its own isolated session. Type the same value as another account to share a login/session."/>
            </StackPanel>

            <!-- footer -->
            <Grid Grid.Row="2" Margin="20,10,20,18">
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource StoppedBrush}" FontSize="12"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource GhostButton}" Click="Cancel_Click" Margin="0,0,10,0"/>
                    <Button Content="Save" Style="{StaticResource AccentButton}" Click="Save_Click" MinWidth="90"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
