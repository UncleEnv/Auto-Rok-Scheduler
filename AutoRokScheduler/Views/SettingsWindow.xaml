<Window x:Class="AutoRokScheduler.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="480" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        TextElement.Foreground="{StaticResource TextBrush}"
        TextElement.FontFamily="Segoe UI" TextElement.FontSize="13">
    <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- title bar -->
            <Grid Grid.Row="0" Background="{StaticResource SidebarBrush}" Height="40" MouseLeftButtonDown="TitleBar_MouseDown">
                <TextBlock Text="Settings" Margin="14,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <Button Content="&#x2715;" Style="{StaticResource CloseButton}" HorizontalAlignment="Right" Click="Cancel_Click"/>
            </Grid>

            <!-- form -->
            <StackPanel Grid.Row="1" Margin="20,18,20,4">

                <TextBlock Text="DEFAULT BROWSER" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="BrowserCombo" Width="160" HorizontalAlignment="Left">
                    <ComboBoxItem Content="Edge"/>
                    <ComboBoxItem Content="Chrome"/>
                </ComboBox>

                <!-- toggle rows -->
                <Grid Margin="0,18,0,0">
                    <TextBlock Text="Run browser hidden (headless)" VerticalAlignment="Center"/>
                    <ToggleButton x:Name="HeadlessToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock Text="Off lets you watch the browser work." Foreground="{StaticResource IdleBrush}" FontSize="11" Margin="0,3,0,0"/>

                <Grid Margin="0,16,0,0">
                    <TextBlock Text="Quit browser after each action" VerticalAlignment="Center"/>
                    <ToggleButton x:Name="CloseAfterToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"/>
                </Grid>

                <Grid Margin="0,16,0,0">
                    <TextBlock Text="Catch up a missed schedule on launch" VerticalAlignment="Center"/>
                    <ToggleButton x:Name="CatchUpToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock Text="If on, a time that already passed today still fires once when the app opens." Foreground="{StaticResource IdleBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SCHEDULE POLL (SECONDS)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="PollBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ACTION TIMEOUT (SECONDS)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TimeoutBox"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="BROWSER PEEK WINDOW (SIZE / POSITION)" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Width" Foreground="{StaticResource IdleBrush}" FontSize="11" Margin="2,0,0,3"/>
                        <TextBox x:Name="WinWidthBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Height" Foreground="{StaticResource IdleBrush}" FontSize="11" Margin="2,0,0,3"/>
                        <TextBox x:Name="WinHeightBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Left" Foreground="{StaticResource IdleBrush}" FontSize="11" Margin="2,0,0,3"/>
                        <TextBox x:Name="WinLeftBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Top" Foreground="{StaticResource IdleBrush}" FontSize="11" Margin="2,0,0,3"/>
                        <TextBox x:Name="WinTopBox"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- footer -->
            <Grid Grid.Row="2" Margin="20,16,20,18">
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource StoppedBrush}" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource GhostButton}" Click="Cancel_Click" Margin="0,0,10,0"/>
                    <Button Content="Save" Style="{StaticResource AccentButton}" Click="Save_Click" MinWidth="90"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
